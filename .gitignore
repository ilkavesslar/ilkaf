# ==============================================================================
# ILKA — Industrial Safety Platform .gitignore
# ==============================================================================

# Environment & Secrets (NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
secrets/
credentials/
*.pem
*.key
*.crt
*.pfx
*.cert
*.p12

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.venv-cv/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# Node.js, React & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
dist-ssr/
*.local
.next/
out/
.nuxt/
.vuepress/dist
.cache/
coverage/

# Computer Vision & AI Models (Weights & Raw Checkpoints)
*.pt
*.pth
*.onnx
*.engine
*.weights
*.tflite
*.h5
*.hdf5
*.ckpt
*.bin
*.safetensors
data/raw/
data/processed/
data/models/*
!data/models/README.md
data/videos/
data/snapshots/
data/recordings/
data/cache/
*.partial

# Databases & Local Storage
*.sqlite3
*.db
pgdata/
redisdata/

# IDEs & Editor Configuration
.idea/
# Ignore editor files inside .vscode, but keep the shared settings, tasks, launch, and extensions files.
# A `.vscode/` directory rule would block the exceptions below.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# AI Agents & IDE Workspace State (Cursor / Antigravity Scratch)
# Commit shared rules, skills, and MCP documentation; ignore local scratch.
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**
!.cursor/mcp.json
!.cursor/README.md
.cursorrules.local
*.scratch
scratch/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs & Temporary Files
logs/
*.log
tmp/
temp/
