# ==============================================================================
# ILKA environment template — placeholders only. Copy to .env (gitignored).
# ==============================================================================

# REQUIRED for running the API process
APP_NAME=ILKA
APP_ENV=development
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_NAME=ilka-backend
PLATFORM_HOST=0.0.0.0
PLATFORM_PORT=8000

# REQUIRED for CORS (comma-separated)
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_BASE_URL=http://localhost:8000/api/v1

# ILKA custom authentication. The secret signs session tokens. Must be at least
# 32 bytes in production and must never be committed.
# AUTH_SECRET_KEY=replace_with_secure_secret
AUTH_SECRET_KEY=
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_SESSION_COOKIE_NAME=ilka_session
AUTH_SESSION_COOKIE_SAMESITE=lax
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Tests only. Leave empty outside the test suite. Production refuses a value.
ILKA_AUTH_TEST_SECRET=

# Database. REQUIRED in production (`DATABASE_URL` only) and for GET /ready
# (resolved URL).
# Canonical runtime variable: DATABASE_URL.
# Neon (preferred shared dev): set ILKA_POSTGRES_URL in .env only (never commit).
# If DATABASE_URL is empty, development/tests use ILKA_POSTGRES_URL.
# Production startup refuses a missing DATABASE_URL even if ILKA_POSTGRES_URL is set.
# CI uses a disposable GitHub Actions PostgreSQL URL, not Neon.
# Optional local Compose: postgresql+asyncpg://ilka:ilka_dev_only@localhost:5432/ilka
# Placeholders only — put real URLs in gitignored `.env`, never here.
# DATABASE_URL=your_database_connection_string
# ILKA_POSTGRES_URL=your_neon_or_postgres_connection_string
DATABASE_URL=
ILKA_POSTGRES_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_READONLY_URL=
NEON_PROJECT_ID=
NEON_BRANCH=development
NEON_DATABASE_NAME=

# Redis: unused (ADR 0006). Leave empty.
REDIS_URL=
REDIS_STREAM_KEY=

# Local SSDLite weights for the provisional CPU person detector (gitignored).
# CpuPersonDetector does not download weights. The file must match the pinned
# SHA-256 in cv/detectors/person_cpu.py. Fetch it with
# scripts/dev/fetch_person_detector_weights.py, which keeps the file only
# after that digest matches.
# Example after fetch:
# ILKA_CV_PERSON_WEIGHTS=data/models/ssdlite320_mobilenet_v3_large_coco.pth
ILKA_CV_PERSON_WEIGHTS=

# Lab cache for the local MP4 person-observation demo. Not a database and not incidents.
# Empty uses data/cache/demo-person-observations.json (gitignored).
ILKA_DEMO_OBSERVATIONS_PATH=

# Local-development live preview for the two verified VIGI cameras.
# Off unless true. Refused when ENVIRONMENT=production.
# Uses ILKA_CAMERA_USERNAME and ILKA_CAMERA_PASSWORD. Do not add another password variable.
# Leave both empty in git. Set them only in the local process environment or .env.
ILKA_CAMERA_USERNAME=
ILKA_CAMERA_PASSWORD=
# Optional site scope: when both IDs are set, the caller must already have that site.
ILKA_LAB_CAMERAS_ENABLED=false
ILKA_LAB_CAMERA_ORGANIZATION_ID=
ILKA_LAB_CAMERA_SITE_ID=
ILKA_LAB_CAMERA_1_HOST=192.168.1.13
ILKA_LAB_CAMERA_1_PORT=554
ILKA_LAB_CAMERA_1_PATH=/stream1
ILKA_LAB_CAMERA_2_HOST=192.168.1.15
ILKA_LAB_CAMERA_2_PORT=554
ILKA_LAB_CAMERA_2_PATH=/stream1
# Seconds between person samples. The camera reader keeps only the latest frame.
ILKA_DETECTION_SAMPLE_INTERVAL_S=2.0

# Cameras / AI: unused in Sprint 0
CAMERA_CONFIGURATION=
RTSP_STREAMS_CONFIG_PATH=
CV_FRAME_STORAGE_PATH=
AI_MODEL_CONFIGURATION=
AI_MODEL_REGISTRY_PATH=

# Frontend public (never put secrets in VITE_*).
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Sentry unused. Leave empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
VITE_SENTRY_DSN=
